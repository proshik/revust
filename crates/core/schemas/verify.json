{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Candidate assessment",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "verdicts": {
      "type": "array",
      "description": "Assessments keyed by the supplied candidate IDs.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "description": "Identity of the supplied candidate."
          },
          "verdict": {
            "type": "string",
            "description": "Disposition after inspecting evidence; refinement supplies corrected fields.",
            "enum": [
              "confirmed",
              "refined",
              "rejected",
              "immaterial",
              "pre_existing",
              "unverified"
            ]
          },
          "line": {
            "type": "integer",
            "description": "Anchor in the file, counted from 1; 0 denotes a file-wide issue.",
            "minimum": 0
          },
          "end_line": {
            "type": "integer",
            "description": "Optional inclusive range end; 0 denotes no additional range.",
            "minimum": 0
          },
          "severity": {
            "type": "string",
            "description": "Impact classification independent of evidence strength.",
            "enum": [
              "critical",
              "major",
              "minor"
            ]
          },
          "confidence": {
            "type": "integer",
            "description": "Evidence strength as a percentage; agreement is not proof.",
            "minimum": 0,
            "maximum": 100
          },
          "title": {
            "type": "string",
            "description": "Concise label for the affected behavior."
          },
          "body": {
            "type": "string",
            "description": "Trigger, causal explanation, consequence and supporting evidence."
          },
          "fix": {
            "type": "string",
            "description": "Supported correction, when known."
          },
          "reason": {
            "type": "string",
            "description": "Evidence and limitations supporting this disposition."
          }
        },
        "required": [
          "id",
          "verdict"
        ]
      }
    }
  },
  "required": [
    "verdicts"
  ]
}
